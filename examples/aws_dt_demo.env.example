# Process environment template for AWS DT Tutor demo.
# Tutor intentionally ignores project-root .env files — import into the process:
#
#   Get-Content .\examples\aws_dt_demo.env.example | ForEach-Object {
#     if ($_ -match '^([^#][^=]+)=(.*)$') { Set-Item -Path "env:$($matches[1])" -Value $matches[2] }
#   }
#
# Prefer the built demo bundle after:
#   python scripts/build_aws_dt_tutor_demo_package.py   (in CognisphereLearningPlugins)
# Or point at the monorepo root for editable installs.

# Demo bundle (after LP build):
COGNISPHERE_LEARNING_PLUGINS_ROOT=D:\Projects\CognisphereLearningPlugins\dist\aws_dt_tutor_demo

# Alternative — monorepo source:
# COGNISPHERE_LEARNING_PLUGINS_ROOT=D:\Projects\CognisphereLearningPlugins
