    },
    {
      "domain": "ap_calculus",
      "relative_path": "plugins/ap_calculus",
      "plugin_manifest": "plugins/ap_calculus/plugin_manifest.json",
      "lifecycle": "available"
    },
    {
      "domain": "aws_certification",
      "relative_path": "plugins/aws_certification",
      "plugin_manifest": "plugins/aws_certification/plugin_manifest.json",
      "lifecycle": "registered"
    }
  ]
}
