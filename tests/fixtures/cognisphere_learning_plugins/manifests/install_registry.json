{
  "registry_id": "cognisphere.learning_plugins.install_registry.v1",
  "registry_version": "1",
  "plugins_root_env": "COGNISPHERE_LEARNING_PLUGINS_ROOT",
  "plugins": [
    {
      "domain": "leetcode",
      "relative_path": "plugins/leetcode",
      "plugin_manifest": "plugins/leetcode/plugin_manifest.json",
