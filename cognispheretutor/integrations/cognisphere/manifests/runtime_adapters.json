{
  "contract_id": "deeptutor.cognisphere.runtime_adapters.v1",
  "phase": "DT-P4/P5/P6",
  "description": "Maps capabilities to callable contracts. Module paths resolve per domain via plugin manifest runtime_modules or module_template — no default domain.",
  "module_template": "cognisphere_plugins.{domain}.{module_key}",
  "adapters": {
    "socratic_tutor": {
      "capability": "socratic_tutor",
      "module_key": "socratic_tutor_runtime",
      "start": "start_dialogue_session",
      "advance": "advance_dialogue",
      "apply_sandbox": "apply_sandbox_feedback",
      "plan": "plan_socratic_dialogue",
      "status": "build_p2_status",
      "hint_level_min": 0,
      "hint_level_max": 4
    },
    "code_verification": {
      "capability": "code_verification",
      "module_key": "sandbox_verification_runtime",
      "verify": "run_categorized_verification",
      "analyze": "analyze_outcome",
      "to_socratic": "to_socratic_feedback",
      "status": "build_p3_status",
      "require_authorized_or_offline": true
    },
    "mistake_memory": {
      "capability": "mistake_memory",
      "module_key": "mistake_memory",
      "record": "record_mistake",
      "record_from_sandbox": "record_mistake_from_sandbox",
      "list": "list_mistakes",
      "suggest": "suggest_tutor_focus",
      "status": "build_lc006_status"
    },
    "skill_graph": {
      "capability": "skill_graph",
      "module_key": "skill_graph_runtime",
      "plan_path": "plan_learning_path",
      "recommend": "recommend_problems",
      "update_mastery": "update_skill_mastery",
      "to_socratic_focus": "to_socratic_focus",
      "query": "query_skill_graph",
      "status": "build_p4_status"
    },
    "benchmark": {
      "capability": "benchmark",
      "module_key": "expert_benchmark_runtime",
      "start_interview": "start_interview_session",
      "run_flow": "run_interview_flow",
      "list_cases": "list_benchmark_cases",
      "query": "query_interview_runtime",
      "status": "build_p5_status"
    }
  }
}
