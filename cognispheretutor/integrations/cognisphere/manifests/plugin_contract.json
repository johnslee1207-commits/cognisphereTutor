{
  "contract_id": "deeptutor.cognisphere.plugin_contract.v1",
  "schema_id": "cognisphere.learning_plugin.install_manifest.v1",
  "plugins_root_env": "COGNISPHERE_LEARNING_PLUGINS_ROOT",
  "install_profile_env": "COGNISPHERE_LEARNING_PLUGINS_INSTALL_PROFILE",
  "artifact_dir_env": "COGNISPHERE_ARTIFACT_DIR",
  "sandbox_authorized_env": "COGNISPHERE_SANDBOX_AUTHORIZED",
  "sandbox_authorized_value": "1",
  "legacy_env_aliases": {
    "artifact_dir_env": ["COGNISPHERE_LEETCODE_ARTIFACT_DIR"],
    "sandbox_authorized_env": ["COGNISPHERE_LEETCODE_SANDBOX_AUTHORIZED"]
  },
  "import_cache_env": "COGNISPHERE_IMPORT_CACHE_DIR",
  "trusted_context_base_url_env": "COGNISPHERE_TRUSTED_CONTEXT_BASE_URL",
  "default_sibling_name": "CognisphereLearningPlugins",
  "install_registry_relative_path": "manifests/install_registry.json",
  "sdk_import_root_relative_path": "packages/cognisphere_plugin_sdk/src",
  "plugin_src_relative_template": "plugins/{domain}/src",
  "learning_loop_mapping_manifest": "learning_loop_mapping.json",
  "trusted_context_contract_manifest": "trusted_context_contract.json",
  "runtime_adapters_manifest": "runtime_adapters.json",
  "runtime_state_relative_workspace_path": "cognisphere_runtime",
  "required_manifest_keys": [
    "plugin_id",
    "domain",
    "version",
    "cognisphere_entrypoint",
    "deeptutor_entrypoint"
  ],
  "known_capabilities": [
    "ontology",
    "patterns",
    "rules",
    "benchmark",
    "evidence",
    "socratic_tutor",
    "code_verification",
    "mistake_memory",
    "skill_graph",
    "synthetic_factory",
    "deeptutor_export"
  ],
  "forbidden_in_plugin": [
    "ui",
    "user_management",
    "pageindex_core",
    "tenant_security_core",
    "knowledge_source_download",
    "live_corpus_fetch",
    "independent_knowledge_mirror"
  ],
  "handshake_sot": {
    "contract_id": "cognisphere.tutor.learning_plugin_handshake.v1",
    "docs_relative": "CognisphereLearningPlugins/docs/CognisphereTutor_Learning_Plugin_Contract_Handshake_Protocol_v1.0.md",
    "sdk_module": "cognisphere_plugin_sdk.handshake",
    "tutor_thin_client": "cognispheretutor.integrations.cognisphere.handshake_client",
    "preferred_api": ["handshake_plugin", "list_handshake_domains", "pack_for_tutor"],
    "fail_closed_without_packs_root": true,
    "guided_learning_routes": {
      "list_or_run": "/api/v1/learning/cognisphere/handshake",
      "learning_twin": "/api/v1/learning/cognisphere/handshake/learning-twin",
      "learning_twin_pairs": "/api/v1/learning/cognisphere/handshake/learning-twin/pairs"
    },
    "cli": {
      "handshake": "cognispheretutor cognisphere handshake",
      "learning_twin": "cognispheretutor cognisphere learning-twin",
      "learning_twin_pairs": "cognispheretutor cognisphere learning-twin-pairs"
    },
    "composition_intents": {
      "pass_through": true,
      "wired": ["learn_then_practice", "failure_drill"],
      "sot": "CognisphereLearningPlugins SDK / digital_twin_pack_profile + twin packs"
    }
  },
  "visualization_advert_sot": {
    "contract_id": "cognisphere.tutor.twin_visualization_advert.v1",
    "roadmap_id": "N-15",
    "sdk_module": "cognisphere_plugin_sdk.digital_twin",
    "tutor_thin_client": "cognispheretutor.integrations.cognisphere.visualization_advert_client",
    "preferred_api": [
      "consume_visualization_advert",
      "list_visualization_adverts",
      "run_visualization_advert_smoke",
      "visualization_advert_status"
    ],
    "mode": "advert_only",
    "renders_ui": false,
    "note": "Thin status/handshake/smoke of twin visualization advert — no twin UI in LP or Tutor client."
  },
  "cp_socratic_tutor_sot": {
    "contract_id": "cognisphere.tutor.aws_cp_socratic_tutor.v1",
    "roadmap_id": "CP-06",
    "twin_module": "cognisphere_plugins.aws_certification_twin.cp_socratic_tutor",
    "tutor_thin_client": "cognispheretutor.integrations.cognisphere.cp_socratic_tutor_client",
    "preferred_api": [
      "cp_socratic_tutor_status",
      "start_cp_tutor_session",
      "advance_cp_tutor_turn",
      "request_cp_tutor_llm_turn"
    ],
    "mode": "contract_stub",
    "renders_ui": false,
    "mastery_writeback": false,
    "ct08_write_back": false,
    "llm": "host_llm_caller_fail_closed_n02",
    "note": "Thin CP-06 Socratic consume — fixture trees in twin; optional llm_caller; no Tutor UI / CT-08 write-back."
  },
  "cp_product_ux_sot": {
    "contract_id": "cognisphere.tutor.aws_cp_product_ux.v1",
    "roadmap_id": "CP-08",
    "twin_module": "cognisphere_plugins.aws_certification_twin.cp_product_ux",
    "tutor_thin_client": "cognispheretutor.integrations.cognisphere.cp_product_ux_client",
    "preferred_api": [
      "cp_product_ux_status",
      "get_cp_ux_contract_bundle",
      "consume_cp_visualization_advert",
      "run_cp_product_ux_smoke"
    ],
    "reuses_n15": "cognisphere.tutor.twin_visualization_advert.v1",
    "mode": "contract_stub",
    "renders_ui": false,
    "lp_ui": false,
    "marketplace_ui": false,
    "visualization_ui": false,
    "note": "Thin CP-08 Product UX contracts + N-15 viz advert payloads — Tutor owns UI; LP ships data only."
  },
  "context_api_sot": {
    "contract_id": "cognisphere.ops.context_api_boundary.v1",
    "boundary_relative": "CognisphereLearningPlugins/manifests/ops/context_api_boundary.json",
    "sdk_module": "cognisphere_plugin_sdk.context_api",
    "tutor_thin_client": "cognispheretutor.integrations.cognisphere.context_api_client",
    "preferred_api": [
      "try_bind_cognisphere_context_api_client",
      "context_api_status",
      "reset_context_api_client"
    ],
    "base_url_env": "COGNISPHERE_CONTEXT_API_BASE_URL",
    "default_mode": "fail_closed",
    "live_graphql": false
  },
  "required_deeptutor_funcs": [
    "export_deeptutor_package",
    "validate_adapter",
    "negotiate_capabilities"
  ],
  "required_cognisphere_funcs": [
    "get_plugin_info",
    "validate",
    "status"
  ],
  "allowed_source_of_truth": [
    "cognisphere_plugin_pack",
    "cognisphere"
  ],
  "handoff": {
    "bundle_schema_version": "1",
    "required_top_level_keys": [
      "bundle_id",
      "domain",
      "plugin_id",
      "exported_at",
      "knowledge",
      "safety"
    ],
    "required_safety_keys": [
      "no_answer_keys",
      "no_full_solution_dump",
      "source_of_truth"
    ],
    "legacy_timestamp_keys": ["generated_at", "exported_at"]
  }
}
